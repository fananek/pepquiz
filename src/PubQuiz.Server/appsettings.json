{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PubQuiz": {
    "QuizzesDirectory": "quizzes",
    "StateDirectory": "state",
    "HostPin": "",
    "PublicBaseUrl": "",
    "JwtIssuer": "PubQuizEngine",
    "JwtAudience": "PubQuizClients",
    "JwtSecret": "",
    "LatePacketGraceMs": 450,
    "MaxLatencyCompensationMs": 500,
    "TrustForwardedHeaders": false,
    "Https": {
      "Enabled": true,
      "Port": 5443,
      "HttpRedirectPort": 5080,
      "RedirectHttpToHttps": true,
      "CertificatePath": "",
      "CertificateKeyPath": "",
      "CertificatePassword": "",
      "HstsMaxAgeSeconds": 300
    }
  }
}
